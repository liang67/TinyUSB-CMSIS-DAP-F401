JLinkLog.txt
JLinkLog.txt.*
JLinkSettings.ini
keil-build-viewer.log
keil-build-viewer-record.txt

# ---------------------------------------------------------------------------
# Stray ST-internal git metadata shipped inside the HAL vendor tree
