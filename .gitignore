# ---------------------------------------------------------------------------
# Keil MDK-ARM build output (target output folder, see uvprojx OutputDirectory)
# ---------------------------------------------------------------------------
MDK-ARM/00-TINYUSB-DAPLINK/

# ---------------------------------------------------------------------------
# Compiler / linker intermediates (any folder)
# ---------------------------------------------------------------------------
*.o
*.d
*.crf
*.dep
*.axf
*.lnp
*.sct
*.map
*.lst
*.iex

# ---------------------------------------------------------------------------
# Keil user/per-user files (debugger config, breakpoints, window layout)
# ---------------------------------------------------------------------------
*.uvguix.*
*.uvgui.*
*.uvopt
*.uvoptx
*.scvd

# Build log produced by the command line build (UV4 -b ... -o build.log)
MDK-ARM/build.log

# ---------------------------------------------------------------------------
# Vendored TinyUSB: only src/ is needed to build this project, the rest of the
# upstream tree (examples, hw board files, docs, tests, CI config) is dead
# weight.  README/LICENSE/version.yml are kept for provenance.
# ---------------------------------------------------------------------------
Middlewares/Third_Party/tinyusb/.git
Middlewares/Third_Party/tinyusb/.github/
Middlewares/Third_Party/tinyusb/.circleci/
Middlewares/Third_Party/tinyusb/.idea/
Middlewares/Third_Party/tinyusb/docs/
Middlewares/Third_Party/tinyusb/examples/
Middlewares/Third_Party/tinyusb/hw/
Middlewares/Third_Party/tinyusb/lib/
Middlewares/Third_Party/tinyusb/test/
Middlewares/Third_Party/tinyusb/tools/

# ---------------------------------------------------------------------------
# Debug probe logs and settings
# ---------------------------------------------------------------------------
JLinkLog.txt
JLinkLog.txt.*
JLinkSettings.ini
keil-build-viewer.log
keil-build-viewer-record.txt

# ---------------------------------------------------------------------------
# Stray ST-internal git metadata shipped inside the HAL vendor tree
# (renamed to .git.st-origin so git does not treat Inc/Legacy/ as a submodule)
# ---------------------------------------------------------------------------
Drivers/STM32F4xx_HAL_Driver/Inc/Legacy/.git*

# ---------------------------------------------------------------------------
# Editors / IDEs
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*~
.bak/

# ---------------------------------------------------------------------------
# OS clutter
# ---------------------------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
